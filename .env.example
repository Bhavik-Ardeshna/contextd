# ContextD Environment Variables
# Copy this file to .env and update with your values.
# `make start` creates .env automatically, generates local secrets, and removes
# retired settings from older local files. Never commit your .env file.

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_USER=contextd
POSTGRES_PASSWORD=contextd-dev-password
POSTGRES_DB=contextd

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend (when running `make backend`; set BACKEND_PORT if 8001 is in use)
BACKEND_PORT=8001

# Frontend + API for network access (optional; e.g. access at http://192.168.1.165:8082)
# VITE_API_URL = your machine's LAN IP + backend port (e.g. http://192.168.1.165:8002)
# FRONTEND_DEV_PORT = port for frontend dev server (e.g. 8082)
# Backend allows all CORS origins when ENVIRONMENT=local so frontend and backend can talk over LAN.
# VITE_API_URL=http://192.168.1.165:8002
# FRONTEND_DEV_PORT=8082

# Authentication
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin
# Leave blank locally; `make start` writes a generated value.
ENCRYPTION_KEY=
AUTH_ENABLED=false
# Leave blank locally; `make start` writes a generated value.
STATE_SECRET=

# Auth0 Configuration (required if AUTH_ENABLED=true)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_RULE_NAMESPACE=

# ADK vector memory configuration
# The application search path uses Neo4j fulltext. Milvus is reserved for ADK
# memory storage.
VECTOR_STORE_PROVIDER=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=contextd_adk_memories
SESSION_REDIS_HOST=localhost
SESSION_REDIS_PORT=6379
LANGFUSE_ENABLED=false

# Neo4j / Graph Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=contextd-dev-password
NEO4J_DATABASE=neo4j
GRAPH_ENABLED=true
GRAPH_BATCH_SIZE=100
GRAPH_FULLTEXT_ENABLED=true
GRAPH_FULLTEXT_ANALYZER=standard

# Graph traversal strategy (apoc, pcst, ppr)
GRAPH_TRAVERSAL_STRATEGY=pcst
# Subgraph-to-text for LLM context: rule_based_flattening | eulerian_path
GRAPH_SUBGRAPH_TEXT_MODE=eulerian_path
GRAPH_GDS_ENABLED=true
GRAPH_GDS_GRAPH_NAME=contextd_graph
GRAPH_PCST_NODE_LABELS=GraphNode
GRAPH_PCST_REL_TYPES=RELATES_TO
GRAPH_PCST_PRIZE_PROPERTY=pcst_prize
GRAPH_PCST_EDGE_WEIGHT_PROPERTY=
GRAPH_PCST_PRIZE_SCALE=1
# PPR (Personalized PageRank) strategy
GRAPH_PPR_NODE_LABELS=GraphNode
GRAPH_PPR_REL_TYPES=RELATES_TO
GRAPH_PPR_DAMPING_FACTOR=0.85
GRAPH_PPR_MAX_ITERATIONS=20
GRAPH_PPR_USE_ELBOW=true
GRAPH_PPR_TOP_K=100
# GRAPH_PPR_SCORE_THRESHOLD=0.01

# API Keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# ContextD LLM gateway
LLM_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_EXTRACTION_MODEL=
LLM_ANSWER_SYNTHESIS_MODEL=gpt-4o
LLM_AGENT_MODEL=gpt-4o
LLM_PROPERTY_SYNTHESIS_MODEL=
LLM_SCHEMA_MODEL=
LLM_TOKENIZER=o200k_base
LLM_CONTEXT_WINDOW=128000
LLM_COMPLETION_TIMEOUT_SECONDS=120
LLM_STRUCTURED_OUTPUT_TIMEOUT_SECONDS=120
LLM_EMBEDDING_TIMEOUT_SECONDS=300
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_EMBEDDING_MODEL_1536=text-embedding-3-small
LLM_EMBEDDING_MODEL_3072=text-embedding-3-large
LLM_EMBEDDING_TOKENIZER=cl100k_base
LLM_EMBEDDING_MAX_TOKENS=8192

# Search/indexing live path
SEARCH_INDEX_BACKEND=neo4j-fulltext
USE_ENTITY_INDEXING=true
INDEX_FULLTEXT_ENABLED=true

# Graph Chat: log redacted LLM prompt diagnostics in backend when true.
# Prompt/context contents stay redacted in logs.
SHOW_LLM_PROMPT=false
# Encode prompt context as TOON before sending to LLM (reduces tokens)
USE_TOON=true

# Development Settings
LOCAL_DEVELOPMENT=true
LOCAL_CURSOR_DEVELOPMENT=false
ENVIRONMENT=local
FRONTEND_LOCAL_DEVELOPMENT_PORT=8080
SKIP_AZURE_STORAGE=true
STRIPE_ENABLED=false


# Temporal Configuration
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=contextd-sync-queue
TEMPORAL_ENABLED=true

# Custom Deployment URLs
# REQUIRED for any non-localhost deployment (LAN server, VPS, etc.)
# OAuth callbacks are sent to API_FULL_URL/source-connections/callback — must be reachable from the user's browser
# After OAuth completes, the user is redirected to APP_FULL_URL
# Examples:
#   LAN server:    API_FULL_URL=http://192.168.1.165:8002   APP_FULL_URL=http://192.168.1.165:8080
#   Public server: API_FULL_URL=https://api.example.com     APP_FULL_URL=https://app.example.com
#
# OAuth redirect_uri_mismatch (Error 400): Add the EXACT callback URL in each connector's OAuth app:
#   - Local (default):  http://localhost:8001/source-connections/callback
#   - Custom backend:  {API_FULL_URL}/source-connections/callback
#   - No trailing slash. Add this as "Authorized redirect URI" in Google, Azure, Slack, etc.
API_FULL_URL=
APP_FULL_URL=
ADDITIONAL_CORS_ORIGINS=

# Other Settings
PROJECT_NAME=ContextD
LOG_LEVEL=INFO
ANALYTICS_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
RUN_ALEMBIC_MIGRATIONS=true
RUN_DB_SYNC=true
CODE_SUMMARIZER_ENABLED=false

# Source Connectors (Auto-configuration)
GITHUB_ACCESS_TOKEN=
GITHUB_REPOSITORY_NAME=
SLACK_ACCESS_TOKEN=
NOTION_ACCESS_TOKEN=
LINEAR_API_KEY=
ASANA_ACCESS_TOKEN=
GOOGLE_ACCESS_TOKEN=
GMAIL_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_DOCS_ACCESS_TOKEN=
OUTLOOK_CALENDAR_ACCESS_TOKEN=

# Postgres Source Connector (direct auth)
POSTGRES_SOURCE_HOST=
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_DB=
POSTGRES_SOURCE_USER=
POSTGRES_SOURCE_PASSWORD=
POSTGRES_SOURCE_SCHEMA=public
POSTGRES_SOURCE_TABLES=*
