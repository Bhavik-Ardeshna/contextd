# API URL for development
VITE_API_URL=http://localhost:8001

# Auth settings - Enable auth in development mode
# Set to "true" to enable authentication in development
VITE_ENABLE_AUTH=false

# Disable auth entirely - bypasses login screen for testing
# When true, auto-authenticates as the system user (no login required)
VITE_DISABLE_AUTH=false

# Dev auth - Enable local email+password authentication
# When true, shows login/signup form instead of Auth0
VITE_DEV_AUTH=true

# Auth0 credentials (only needed if VITE_ENABLE_AUTH=true)
VITE_AUTH0_DOMAIN=your-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=your-audience

# Analytics is disabled unless explicitly enabled with a key
VITE_ANALYTICS_ENABLED=false
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
