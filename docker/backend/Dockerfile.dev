FROM python:3.13-slim

WORKDIR /app

# Install system dependencies and poetry
RUN apt-get update && apt-get install -y \
    curl \
    unixodbc \
    unixodbc-dev \
    exiftool \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir poetry==1.8.4

# Add Poetry to PATH
ENV PATH="/root/.local/bin:$PATH"

# Configure poetry
RUN poetry config virtualenvs.create false

# Copy locked dependency inputs. Development builds should use the committed lock file too.
COPY backend/pyproject.toml backend/poetry.lock ./
COPY backend/contextd-adk ./contextd-adk

# Install dependencies only (no root project)
RUN poetry install --no-interaction --no-ansi --no-root

# P-Agent needs matplotlib for plot generation
RUN pip install --no-cache-dir "matplotlib>=3.8"

# Copy entrypoint script outside /app so bind mounts cannot hide it.
COPY docker/backend/entrypoint.dev.sh /usr/local/bin/contextd-backend-entrypoint-dev.sh
RUN chmod 755 /usr/local/bin/contextd-backend-entrypoint-dev.sh

# The application code will be mounted as a volume
# This allows for hot reloading without rebuilding the container

# Set environment variable to indicate development mode
ENV CONTEXTD_ENV=development

# Expose the port
EXPOSE 8001

# Use the development entrypoint
ENTRYPOINT ["/bin/bash", "/usr/local/bin/contextd-backend-entrypoint-dev.sh"]
